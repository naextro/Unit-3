{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/ticker"
  ],
  "modules-right": [
  "group/traygroup",
  "custom/pomodoro",
  "cpu",
  "memory",
  "network",
  "backlight",
  "pulseaudio",
  "clock",
  "custom/power"
],

"backlight": {
  "format": "BRI {percent}%",
  "on-scroll-up": "brightnessctl set 5%+",
  "on-scroll-down": "brightnessctl set 5%-",
  "interval": 2
},

"group/traygroup": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 300,
    "children-class": "tray-item",
    "transition-left-to-right": true
  },
  "modules": [
    "custom/tray-toggle",
    "tray"
  ]
},

"custom/tray-toggle": {
  "format": "▸",
  "tooltip": false
},

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "// {title}",
    "max-length": 40
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "on-click": "kitty -e htop"
  },
  "memory": {
    "format": "MEM {percentage}%",
    "interval": 3,
    "on-click": "kitty -e htop"
  },
  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "ETH {ifname}",
    "format-disconnected": "NET --",
    "tooltip-format": "{ipaddr}",
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL --",
    "on-click": "pavucontrol"
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%Y/%m/%d}",
    "tooltip-format": "{:%A %d %B %Y}"
  },

  "custom/ticker": {
    "exec": "echo 'FREE PALESTINE // GLORY TO MANKIND'",
    "interval": 60,
    "format": "{}"
  },


  "custom/power": {
    "format": "⏻",
    "on-click": "hyprctl dispatch exit"
  }
}